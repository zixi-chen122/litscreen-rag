# Copy to .env and fill in. Never commit .env.

# --- Model provider: azure_v1 (Azure AI Foundry, v1 API), azure (classic), or openai ---
LLM_PROVIDER=azure_v1

# Azure (azure_v1: endpoint ends in /openai/v1; azure: https://<resource>.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Only for LLM_PROVIDER=azure:
# AZURE_OPENAI_API_VERSION=2024-10-21

# Plain OpenAI (LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-5-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- App ---
# Require this password to open the app. Leave unset only on a private machine.
APP_PASSWORD=

# --- Storage (defaults suit local use; the Docker image points these at /data) ---
# LITSCREEN_DB_PATH=./litscreen.db
# CHROMA_PERSIST_DIR=./chroma_db
# REVIEW_QUEUE_PATH=data/review_queue.jsonl

# --- Reliability and throughput ---
# LLM_TIMEOUT=60            # seconds per model call
# LLM_MAX_RETRIES=3         # retried with backoff on errors and rate limits
# SCREENING_CONCURRENCY=4   # papers screened in parallel; lower it on rate limits
# LOG_LEVEL=INFO
